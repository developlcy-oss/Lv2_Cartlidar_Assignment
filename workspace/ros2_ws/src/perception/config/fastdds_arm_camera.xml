<?xml version="1.0" encoding="UTF-8"?>
<!-- 팔 카메라 노드 전용. 1280x720 bgr8 한 장(2.76 MB)이 Fast DDS 기본 공유 메모리(0.5 MB)보다 커서
     best effort 구독에서 장이 버려진다(Jetson 실측 11 Hz → 이 설정 15.3 Hz, 드라이버 주기와 같음). UDP 는 다른 컴퓨터 통신용으로 유지. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp4</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="arm_camera_shm_big" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp4</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
