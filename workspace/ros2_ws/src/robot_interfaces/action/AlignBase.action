# drive_node — 모드는 goal 수신 뒤 첫 새 result 의 ARM_ALIGN 비트로 정하고 끝까지 유지 (box_only 면 인식 결과 없이 박스 모드)
float32 target_distance   # m — 정밀(ARM_ALIGN): TFmini 기준 >= 0.10 / 먼 거리: 범퍼 기준 (D435)
float32 tolerance
bool box_only              # true = 퍽 없이 (#160 장소 상자): 인식 결과를 보지 않고 시작 yaw 를 유지한 채 TFmini 박스 거리만으로 target_distance 까지 (>= 0.10)
bool center                # true = 상자 중앙 맞춤 (11-20): FINE 자리에서 center_box (mission 이 BOX_VIEW 로 잰 상자 중심 · 요) 로
                           #   법선 회전 · 옆 이동 · 법선 유지 (TFmini) → 옮겼으면 퍽 arm_offset 마무리. 정밀 모드 (ARM_ALIGN) 를 켜고 보냄.
                           #   믿기 어려운 값 (옆 > max_shift · 상자가 뒤) · 뒤 여유 없음 → 움직이지 않고 성공. 기동 중 문제 → 같은 goal 에서 기존 FINE
geometry_msgs/PoseStamped center_box   # center 일 때 상자 윗면 중심 · 요 (frame 아무거나, drive 가 odom 으로 옮김. 요는 90° 마다 같음)
int32 center_iter          # (11-21) mission 반복 번호 k (0 부터). drive 는 로그 · 결과에만 씀 (반복 판단은 mission, control/box_center.hpp decide_loop)
---
bool success
string message
# (11-21) center goal 결과 — mission center_box 반복 루프가 다음 판단에 씀. center 가 아니면 center_status 0 · 나머지 NaN
int8 CENTER_NONE=0
int8 CENTER_DONE=1         # 옆 오차가 허용 안 → 기동 없이 법선 yaw + TFmini 유지만
int8 CENTER_MOVED=2        # 옆 이동 기동 끝 (center_lateral = odom 으로 본 남은 옆 오차, 진짜 값은 mission 재측정)
int8 CENTER_SKIPPED=3      # 움직이지 않음 (center_reason: max_shift · behind · rear_room · corner · no_scan · odom · tf · disagree · disabled)
int8 CENTER_FALLBACK=4     # 기동 중 문제 → 기존 FINE 으로 되돌아가 끝냄 (center_reason: fallback_*)
int8 center_status
string center_reason       # 기계용 짧은 코드 (위). 사람용 설명은 message
float32 center_lateral     # [m] + = 로봇이 상자 중심선 왼쪽 (끝 자세, 받은 상자 · odom 기준)
float32 center_yaw_err     # [rad] 상자 법선 − 로봇 yaw (끝 자세)
float32 shift_planned      # [m] 이번 기동 옆 이동 계획 (0 = 안 함, + = 왼쪽)
float32 lidar_gap          # [m] /scan_front 앞면: 차체 앞 끝 → 상자 면 (끝 자세). NaN = 못 잼 (틈 < 약 0.14 · 점 부족)
float32 lidar_yaw          # [rad] 라이다 앞면 법선 − 로봇 yaw. NaN = 못 잼
float32 lidar_lateral      # [m] 라이다 앞면 중심 기준 로봇 옆 (+ = 로봇이 왼쪽, 교차확인용 σ 1 ~ 2 cm). NaN = 못 잼
---
float32 lateral_error
float32 distance
