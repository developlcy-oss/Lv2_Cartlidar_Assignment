    def Xform "base_link" (
        prepend references = @./geometries.usd@</Geometries/base_link>
    )
    {
        over "base_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link/VisualMaterials/defaultmaterial>
        }

        def Scope "VisualMaterials"
        {
            def Material "defaultmaterial" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/defaultmaterial>
            )
            {
            }
        }
    }

